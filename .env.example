# Copy to .env and fill in. .env is git-ignored.
# Account identifier format: <orgname>-<account_name> (e.g. abcdefg-xy12345).
# Run setup/snowflake_keypair.sql in Snowsight: it prints both values below.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=

# Auth: key-pair (recommended) — path to an unencrypted PKCS#8 private key whose public
# key is registered on the NYC_TLC_SVC service user (see setup/snowflake_keypair.sql).
SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/nyc_tlc_rsa_key.p8
# ...or password auth: leave SNOWFLAKE_PRIVATE_KEY_PATH empty and set this instead.
SNOWFLAKE_PASSWORD=

SNOWFLAKE_ROLE=NYC_TLC_TRANSFORMER
SNOWFLAKE_WAREHOUSE=NYC_TLC_WH
SNOWFLAKE_DATABASE=NYC_TLC
